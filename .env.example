# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase — image hosting
#
# Leave NEXT_PUBLIC_SUPABASE_URL blank to serve images from /public/assets
# (the default; the site works fully without Supabase). Once you set it, every
# image is loaded from the bucket instead.
#
# The service-role key is only used by `npm run upload-assets`. It is a secret:
# never prefix it with NEXT_PUBLIC_ and never commit it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_BUCKET=site-assets
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend — contact form delivery
#
# CONTACT_FROM_EMAIL must be on a domain verified in Resend.
# CONTACT_TO_EMAIL accepts a comma-separated list.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
