# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase — image hosting
#
# Leave NEXT_PUBLIC_SUPABASE_URL blank to serve images from /public/assets
# (the default; the site works fully without Supabase). Once you set it, every
# image is loaded from the bucket instead. It must also be set at BUILD time,
# because next.config.ts derives the next/image host whitelist from it.
#
# SUPABASE_SECRET_KEY: Settings -> API Keys -> "Secret keys" (sb_secret_...).
# Used only by `npm run upload-assets`; it never reaches the browser. Never
# prefix it with NEXT_PUBLIC_ — that would inline it into the client bundle.
#
# No publishable/anon key is needed: the bucket is public, so the browser just
# fetches ordinary image URLs.
#
# The legacy name SUPABASE_SERVICE_ROLE_KEY is still accepted as a fallback.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_BUCKET=site-assets
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Resend — contact form delivery
#
# CONTACT_FROM_EMAIL must be on a domain verified in Resend.
# CONTACT_TO_EMAIL accepts a comma-separated list.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Zapier catch hook that receives every lead (defaults to the production hook in code).
ZAPIER_WEBHOOK_URL=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
